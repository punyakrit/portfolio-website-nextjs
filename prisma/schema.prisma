
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Workers refuse WebAssembly.Module() on raw bytes ("Wasm code generation
  // disallowed by embedder"). The default (nodejs) client ships Prisma's query
  // compiler as base64 and compiles it at runtime, which fails there. The
  // workerd target emits a client that imports the .wasm statically instead, so
  // it is part of the uploaded bundle.
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id
  createdAt DateTime @default(now())
  ip String
  userLogs UserLog[]
  blogsUser BlogsUser[]
  @@index([id])
}

model UserLog{
  id String @id @default(nanoid())
  userId String
  visitCount Int @default(0)
  lastVisitedAt DateTime @default(now())
  createdAt DateTime @default(now())
  ip String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastVisitedAt])
  @@index([createdAt])
}



model BlogsUser {
  id String @id @default(nanoid())
  blogSlug String
  isLiked Boolean @default(false)
  Isviewed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([blogSlug])
  @@index([updatedAt])
  @@index([isLiked])

}
