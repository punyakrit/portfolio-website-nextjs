    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "lightningcss": "^1.30.2",
    "prisma": "^7.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  }
