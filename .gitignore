# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the public build-time config. Every value in it is a NEXT_PUBLIC_*
# string that Next already inlines into the shipped client bundle, so it is
# public whether or not it is in git. Committing it keeps the build reproducible
# outside the Cloudflare dashboard. Secrets stay out - see the file's header.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# cloudflare / opennext build output
.open-next/
.wrangler/
